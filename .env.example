# Set these in your environment before starting the service.
# On Cloud Run set these as service/job environment variables instead.

# --- Where state lives ----------------------------------------------------
# "local" (default) keeps everything under AI_SIGNAL_DATA_DIR on disk.
# "gcs" keeps everything in a bucket -- required on Cloud Run, whose
# container filesystem is discarded on every cold start.
AI_SIGNAL_STORAGE=local

# Bucket name only, no gs:// and no path. Required when AI_SIGNAL_STORAGE=gcs.
AI_SIGNAL_BUCKET=

# Optional key prefix, if the bucket is shared with something else.
# Empty means objects sit at the bucket root: watchlist/, archive/, logs/.
AI_SIGNAL_PREFIX=

# Only used when AI_SIGNAL_STORAGE=local.
AI_SIGNAL_DATA_DIR=data/ai-signal

# --- Optional extras ------------------------------------------------------
# Adds Brave Search as a second provider alongside the RSS feeds.
# BRAVE_API_KEY=

# Forces the offline demo dataset. Leave unset for real searches.
# AI_SIGNAL_DEMO_MODE=

# Optional Google News keyword RSS discovery. Its feed states that it is for
# personal, non-commercial use; leave disabled for a commercial deployment
# unless your usage review confirms that your use is permitted.
# AI_SIGNAL_GOOGLE_NEWS=1

# --- Credentials ----------------------------------------------------------
# On Cloud Run: do NOT set this. The service account attached to the
# service is picked up automatically.
# Locally, either run `gcloud auth application-default login` or point at a
# service-account key file:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json
